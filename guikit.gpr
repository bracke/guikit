with "config/guikit_config.gpr";
project Guikit is

   for Library_Name use "Guikit";
   for Library_Version use Project'Library_Name & ".so." & Guikit_Config.Crate_Version;

   --  One body per window system for what only it has (the native window
   --  handle behind a GLFW window).
   case Guikit_Config.Alire_Host_OS is
      when "windows" =>
         for Source_Dirs use ("src/", "config/", "src/platform/windows");
      when "macos" =>
         for Source_Dirs use ("src/", "config/", "src/platform/macos");
      when others =>
         for Source_Dirs use ("src/", "config/", "src/platform/other");
   end case;
   for Object_Dir use "obj/" & Guikit_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("GUIKIT_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use
        Guikit_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnatwU");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Guikit;
